(version 1)
# Generated by tools/v4/domain_rules.py - do not edit. IEC 61010-1 insulation spacing
# between the domains of tools/v4/domains.py (copper to copper on each layer; zone fills
# keep these gaps automatically).

(rule "C-I reinforced 5.0 mm"
  (constraint clearance (min 5.0mm))
  (condition "(A.NetClass == 'DOM_C' && B.NetClass == 'DOM_I') || (A.NetClass == 'DOM_I' && B.NetClass == 'DOM_C')"))

(rule "C-P reinforced 5.0 mm"
  (constraint clearance (min 5.0mm))
  (condition "(A.NetClass == 'DOM_C' && B.NetClass == 'DOM_P') || (A.NetClass == 'DOM_P' && B.NetClass == 'DOM_C')"))

(rule "E-I basic 2.5 mm"
  (constraint clearance (min 2.5mm))
  (condition "(A.NetClass == 'DOM_E' && B.NetClass == 'DOM_I') || (A.NetClass == 'DOM_I' && B.NetClass == 'DOM_E')"))

(rule "E-P basic 2.5 mm"
  (constraint clearance (min 2.5mm))
  (condition "(A.NetClass == 'DOM_E' && B.NetClass == 'DOM_P') || (A.NetClass == 'DOM_P' && B.NetClass == 'DOM_E')"))

(rule "I-P reinforced 5.0 mm"
  (constraint clearance (min 5.0mm))
  (condition "(A.NetClass == 'DOM_I' && B.NetClass == 'DOM_P') || (A.NetClass == 'DOM_P' && B.NetClass == 'DOM_I')"))
